          radial-gradient(120% 90% at 50% 120%, rgba(180, 154, 230, 0.55), transparent 60%),
          radial-gradient(60% 60% at 10% 0%, rgba(111, 140, 255, 0.25), transparent 70%),
          #2a1d4a;
        border: 1px solid rgba(255, 255, 255, 0.08);
