      /* The stamp lands when the section comes into view, and ink splashes around it. */
      .stamp {
        display: block;
        margin: -12px auto 8px;
        color: #d6c6f6;
        overflow: visible;
      }
      .stamp .drops circle {
        fill: currentColor;
        opacity: 0.85;
        transform-box: fill-box;
        transform-origin: center;
      }
      .stamp .mark {
        transform-box: fill-box;
        transform-origin: center;
      }
      .js .final .stamp .mark {
        opacity: 0;
      }
      .js .final .stamp .drops circle {
        transform: scale(0);
      }
      .js .final.in .stamp .mark {
        animation: stamp 0.55s cubic-bezier(0.3, 0, 0.2, 1) 0.25s both;
      }
      .js .final.in .stamp .drops circle {
        animation: splash 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) var(--d) both;
      }
      .js .final.in {
        animation: thud 0.35s ease-out 0.62s;
      }
      @keyframes stamp {
        0% {
          opacity: 0;
          transform: scale(2.6) rotate(10deg);
        }
        55% {
          opacity: 1;
          transform: scale(0.92) rotate(-2deg);
        }
        75% {
          transform: scale(1.04) rotate(0.5deg);
        }
        100% {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes splash {
        from {
          transform: translate(var(--dx), var(--dy)) scale(0);
        }
        to {
          transform: scale(1);
        }
      }
      @keyframes thud {
        30% {
          transform: translateY(3px) scale(0.995);
        }
      }
      .final h2 {
