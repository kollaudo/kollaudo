---
// The frame of every page outside the docs: the header, the footer and the styles they share.
import "@fontsource/instrument-serif/latin-400-italic.css";
import logo from "../../../../docs/assets/logo.svg";
import logoDark from "../../../../docs/assets/logo-dark.svg";
import cli from "../../../../packages/cli/package.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kollaudo: quality gates for every promotion",
  description = "Your CI sends test results. Kollaudo says pass, fail or unknown before a version moves on.",
} = Astro.props;

const links = [
  ["Docs", "/docs/"],
  ["Blog", "/blog/"],
  ["Changelog", "https://github.com/kollaudo/kollaudo/blob/main/CHANGELOG.md"],
  ["FAQ", "/faq/"],
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="brand" href="/">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={logoDark.src} />
            <img src={logo.src} alt="" width="28" height="28" />
          </picture>
          Kollaudo
        </a>
        <nav>
          {
            links.map(([label, href]) => (
              <a href={href} aria-current={href.startsWith("/") && path.startsWith(href) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <div class="actions">
          <a class="button small ghost github" href="https://github.com/kollaudo/kollaudo" aria-label="Kollaudo on GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
          </a>
          <a class="button small" href="/#quick-start">Get started</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="wrap">
      <span>Kollaudo {cli.version} · Apache-2.0</span>
      <span>
        <a href="https://github.com/kollaudo/kollaudo">GitHub</a> · <a href="https://github.com/kollaudo/kollaudo/issues">Issues</a> · <a href="/faq/">FAQ</a> · <a href="/docs/adr/">Decisions</a>
      </span>
    </footer>

    <script is:inline>
      // Sections fade in once, when they scroll into view. Without JavaScript they are just there.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el, i) => {
        el.style.setProperty('--delay', `${(i % 4) * 70}ms`);
        reveal.observe(el);
      });

    </script>

    <style is:global>
      :root {
        --brand: #5b3e96;
        --brand-ink: #ffffff;
        --bg: #f6f2ea;
        --fg: #1c1a22;
        --muted: #6b6578;
        --line: rgba(28, 26, 34, 0.1);
        --glass: rgba(255, 255, 255, 0.62);
        --glass-strong: rgba(255, 255, 255, 0.82);
        --code: rgba(91, 62, 150, 0.06);
        --shadow: 0 30px 80px -40px rgba(63, 42, 108, 0.45);
        --pass: #1a7f37;
        --fail: #cf222e;
        --unknown: #9a6700;
        --none: #6e7781;
        --serif: 'Instrument Serif', ui-serif, Georgia, serif;
        --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        --top: 64px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --brand: #b49ae6;
          --brand-ink: #15111f;
          --bg: #0b0910;
          --fg: #ece8f4;
          --muted: #9a93ab;
          --line: rgba(255, 255, 255, 0.09);
          --glass: rgba(24, 20, 34, 0.55);
          --glass-strong: rgba(24, 20, 34, 0.82);
          --code: rgba(255, 255, 255, 0.04);
          --shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.9);
          --pass: #3fb950;
          --fail: #f85149;
          --unknown: #d29922;
          --none: #8b949e;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a {
        color: var(--brand);
      }
      em {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 400;
        letter-spacing: 0;
      }
      .mono {
        font-family: var(--mono);
      }
      .wrap,
      .top-in,
      .hero-in {
        width: min(1160px, 100% - 32px);
        margin-inline: auto;
      }
      .glass {
        background: var(--glass);
        border: 1px solid var(--line);
        border-radius: 18px;
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
      }

      /* Header */
      .top {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 70%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .top-in {
        display: flex;
        align-items: center;
        gap: 24px;
        height: var(--top);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 1.1rem;
        line-height: 1;
        color: var(--fg);
        text-decoration: none;
      }
      .brand picture,
      .brand img {
        display: block;
      }
      .top nav {
        display: flex;
        gap: 26px;
        margin-inline: auto;
      }
      .top nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.92rem;
      }
      .top nav a:hover,
      .top nav a[aria-current='page'] {
        color: var(--fg);
      }
      .top nav a[aria-current='page'] {
        text-decoration: underline 2px var(--brand);
        text-underline-offset: 8px;
      }
      .actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .button.github {
        width: 36px;
        height: 36px;
        padding: 0;
        justify-content: center;
      }
      .github svg {
        flex: none;
        width: 18px;
        height: 18px;
        fill: currentColor;
      }
      /* On a phone, the links get a row of their own under the name and the buttons. */
      @media (max-width: 720px) {
        :root {
          --top: 96px;
        }
        .top-in {
          flex-wrap: wrap;
          justify-content: space-between;
          gap: 0;
          height: var(--top);
          align-content: center;
        }
        .top nav {
          order: 1;
          width: 100%;
          margin: 12px 0 0;
          justify-content: space-between;
        }
      }

      /* Buttons */
      .button {
        display: inline-flex;
        align-items: center;
        padding: 11px 22px;
        border-radius: 999px;
        background: var(--brand);
        color: var(--brand-ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        border: 1px solid var(--brand);
        transition: transform 0.15s ease, box-shadow 0.2s ease;
      }
      .button:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 30px -10px var(--brand);
      }
      .button.small {
        padding: 7px 16px;
        font-size: 0.88rem;
      }
      .button.ghost {
        background: var(--glass);
        color: var(--fg);
        border-color: var(--line);
        backdrop-filter: blur(10px);
      }
      .button.ghost:hover {
        border-color: var(--brand);
        box-shadow: none;
      }

      /* Sections */
      section.wrap {
        position: relative;
        padding: 88px 0;
      }
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 14px;
        font-size: 0.78rem;
        color: var(--muted);
        text-transform: lowercase;
      }
      .kicker::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--brand);
      }
      h2 {
        font-size: clamp(2rem, 4.4vw, 3.2rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        font-weight: 620;
        margin: 0 0 16px;
        max-width: 18ch;
      }
      h2 em {
        color: var(--brand);
        font-size: 1.06em;
      }
      h3 {
        font-size: 1.1rem;
        letter-spacing: -0.01em;
        margin: 0 0 6px;
      }
      h3 em {
        font-size: 1.15em;
      }
      .sub {
        color: var(--muted);
        margin: 0 0 32px;
        max-width: 52ch;
      }
      .sub code,
      p code {
        font: 0.85em var(--mono);
        padding: 1px 6px;
        border-radius: 6px;
        background: var(--code);
        border: 1px solid var(--line);
      }
      .split {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 0 40px;
      }
      footer {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
        justify-content: space-between;
        padding: 28px 0 40px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a {
        color: var(--muted);
      }

      /* Scroll reveal, only with JavaScript and motion */
      .js .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 0.7s ease var(--delay, 0ms),
          transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0ms),
          border-color 0.2s ease;
      }
      .js .reveal.in {
        opacity: 1;
        transform: none;
      }

      /* Long text: the FAQ and the posts of the blog */
      .prose {
        max-width: 70ch;
        font-size: 1.05rem;
      }
      .prose h2 {
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        max-width: none;
        margin: 56px 0 8px;
        scroll-margin-top: calc(var(--top) + 24px);
      }
      .prose h3 {
        font-size: 1.2rem;
        margin: 36px 0 8px;
        scroll-margin-top: calc(var(--top) + 24px);
      }
      .prose h4 {
        font-size: 1rem;
        margin: 20px 0 4px;
      }
      .prose p,
      .prose ul,
      .prose ol {
        margin: 0 0 14px;
        color: color-mix(in srgb, var(--fg) 82%, var(--muted));
      }
      .prose :is(p, li) em {
        font-size: 1.12em;
      }
      .prose li + li {
        margin-top: 6px;
      }
      .prose .expressive-code {
        margin: 0 0 14px;
      }
      .prose pre {
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--code) !important;
        overflow-x: auto;
        font: 0.85rem/1.6 var(--mono);
      }
      .prose li code,
      .prose td code {
        font: 0.85em var(--mono);
        padding: 1px 6px;
        border-radius: 6px;
        background: var(--code);
        border: 1px solid var(--line);
      }
      .prose blockquote {
        margin: 0 0 14px;
        padding: 4px 0 4px 18px;
        border-left: 3px solid var(--brand);
        color: var(--muted);
      }
      .prose img,
      .prose video {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
      }
      .prose .heading-anchor {
        margin-left: 8px;
        color: var(--muted);
        text-decoration: none;
        opacity: 0;
      }
      .prose :is(h2, h3):hover .heading-anchor {
        opacity: 1;
      }
      .page-head {
        padding: 72px 0 8px;
      }
      .page-head h1 {
        font-size: clamp(2.4rem, 5.5vw, 3.8rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 650;
        margin: 0 0 14px;
      }
      .page-head h1 em {
        color: var(--brand);
        font-size: 1.06em;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .js .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
